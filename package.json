{
  "name": "@theqrl/hypc",
  "version": "0.2.0",
  "description": "Hyperion compiler",
  "main": "index.js",
  "bin": {
    "hypcjs": "hypc.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node build/postbuild.js && cp README.md LICENSE dist/",
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --fix --ext .js,.ts .",
    "updateBinary": "node build/clean.js && ts-node ./downloadCurrentVersion.ts && ts-node ./verifyVersion.ts",
    "prepack": "node build/pack-publish-block.js",
    "build:tarball": "npm run updateBinary && npm run build && BYPASS_SAFETY_CHECK=true npm pack ./dist",
    "publish:tarball": "tarball=$(npm run --silent tarballName) && ls \"$tarball\" && BYPASS_SAFETY_CHECK=true npm publish --access public \"$tarball\"",
    "tarballName": "jq --raw-output '(.name | sub(\"@\"; \"\") | gsub(\"/\"; \"-\")) + \"-\" + .version + \".tgz\"' package.json",
    "copyTestFiles": "cp -r ./test/resources ./dist/test/",
    "pretest": "npm run lint && npm run build && npm run copyTestFiles",
    "test": "cd dist && tape ./test/index.js --no-remote-versions",
    "coverage": "nyc npm run test",
    "coveralls": "npm run coverage && coveralls <coverage/lcov.info"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theQRL/hypc-js.git"
  },
  "keywords": [
    "qrl",
    "hyperion",
    "compiler"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/theQRL/hypc-js/issues"
  },
  "homepage": "https://github.com/theQRL/hypc-js#readme",
  "dependencies": {
    "command-exists": "^1.2.8",
    "commander": "^8.1.0",
    "follow-redirects": "^1.16.1",
    "js-sha3": "0.8.0",
    "memorystream": "^0.3.1",
    "semver": "^5.5.0",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.3.9",
    "@types/tape": "^5.8.1",
    "@types/tmp": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "coveralls": "^3.0.0",
    "eslint": "^10.13.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "nyc": "^18.0.0",
    "tape": "^5.10.3",
    "tape-spawn": "^1.4.2",
    "ts-node": "^10.4.0",
    "typescript": "^7.0.2"
  },
  "nyc": {
    "exclude": [
      "hypjson.js",
      "dist"
    ]
  }
}
